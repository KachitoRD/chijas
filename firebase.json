{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      ".agents/**",
      "reports/**",
      "test-results/**",
      "playwright-report/**",
      "e2e/**",
      "tests/**",
      "scripts/**",
      "**/*.spec.js",
      "**/*.test.js",
      "playwright*.config.js",
      "eslint.config.js",
      "tailwind.config.js",
      "postcss.config.js",
      "build-css.js",
      "package.json",
      "package-lock.json",
      "**/*.log",
      "**/*.tmp",
      "**/*.bak",
      "**/*.map",
      "**/*.md",
      "DAY_*.html",
      "PHASE_*.html",
      "POST_MVP_*.html",
      "TESTING_*.html",
      "IMPROVEMENTS_DASHBOARD.html",
      "IMAGE_OPTIMIZATION_GUIDE.html",
      "FIREBASE_SETUP.md",
      "PRODUCT.md",
      "firestore.rules",
      "firestore.indexes.json",
      "skills-lock.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
