{
  "hosting": {
    "public": ".",
    "redirects": [
      { "source": "/index.html", "destination": "/src/views/public-tipsters.html", "type": 301 },
      { "source": "/admin.html", "destination": "/src/views/tipster-access.html", "type": 301 },
      { "source": "/admin-dashboard.html", "destination": "/src/views/operations-console.html", "type": 301 },
      { "source": "/owner.html", "destination": "/src/views/platform-owner.html", "type": 301 },
      { "source": "/tipster-dashboard.html", "destination": "/src/views/tipster-workspace.html", "type": 301 },
      { "source": "/account-settings.html", "destination": "/src/views/account-settings.html", "type": 301 },
      { "source": "/legal.html", "destination": "/src/views/legal-notice.html", "type": 301 },
      { "source": "/overlay.html", "destination": "/src/views/streaming-overlay.html", "type": 301 },
      { "source": "/user-profile.html", "destination": "/src/views/user-profile.html", "type": 301 }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      ".git",
      ".git/**",
      ".firebase",
      ".firebase/**",
      ".agents/**",
      "docs/**",
      "archivo/**",
      "reports/**",
      "test-results/**",
      "playwright-report/**",
      "e2e/**",
      "tests/**",
      "scripts/**",
      "**/*.spec.js",
      "**/*.test.js",
      "playwright*.config.js",
      "eslint.config.js",
      "tailwind.config.js",
      "postcss.config.js",
      "build-css.js",
      "package.json",
      "package-lock.json",
      "**/*.log",
      "**/*.tmp",
      "**/*.bak",
      "**/*.map",
      "**/*.md",
      "DAY_*.html",
      "PHASE_*.html",
      "POST_MVP_*.html",
      "TESTING_*.html",
      "IMPROVEMENTS_DASHBOARD.html",
      "IMAGE_OPTIMIZATION_GUIDE.html",
      "FIREBASE_SETUP.md",
      "PRODUCT.md",
      "firestore.rules",
      "firestore.indexes.json",
      "skills-lock.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
