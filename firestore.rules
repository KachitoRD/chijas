rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared identity and approval checks.
    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function signedInAs(userId) {
      return verifiedUser() && request.auth.uid == userId;
    }

    function acceptedCurrentTerms(userId) {
      let acceptance = get(/databases/$(database)/documents/legalAcceptances/$(userId)/versions/2026-10-03).data;
      return acceptance.terms_version == "2026-10-03"
        && acceptance.privacy_version == "2026-10-03";
    }

    function isPlatformAdmin() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.enabled == true;
    }

    function profileIsApproved(userId) {
      return exists(/databases/$(database)/documents/perfiles/$(userId))
        && get(/databases/$(database)/documents/perfiles/$(userId)).data.tipster_status == "approved";
    }

    // Username claims must match the profile and application written in the same transaction.
    function ownsUsername(username) {
      return existsAfter(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    function profileOwnsUsername(userId, username) {
      return existsAfter(/databases/$(database)/documents/perfiles/$(userId))
        && getAfter(/databases/$(database)/documents/perfiles/$(userId)).data.tipster_status == "approved"
        && getAfter(/databases/$(database)/documents/perfiles/$(userId)).data.username == username;
    }

    function approvedApplicationClaimsUsername(userId, username) {
      return existsAfter(/databases/$(database)/documents/tipsterApplications/$(userId))
        && getAfter(/databases/$(database)/documents/tipsterApplications/$(userId)).data.status == "approved"
        && getAfter(/databases/$(database)/documents/tipsterApplications/$(userId)).data.requested_username == username
        && profileOwnsUsername(userId, username);
    }

    // URL fields accept only absolute HTTPS URLs; embedded JPEGs are not outbound links.
    function validUsername(username) {
      return username is string && username.matches('^[a-z0-9_-]{3,30}$');
    }

    function validHttpsUrl(value) {
      return value is string && value.size() <= 2048 && value.matches('^https://.+$');
    }

    function validOptionalHttpsUrl(value) {
      return value == null || validHttpsUrl(value);
    }

    function validImage(value) {
      return value == null
        || validHttpsUrl(value)
        || (value is string
          && value.size() <= 204800
          && value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }

    function validProfileFields(profileId) {
      return request.resource.data.keys().hasOnly([
          "id", "username", "nombre_publico", "bio", "color_primario",
          "is_online", "last_active_at", "created_at", "tipster_status"
        ])
        && request.resource.data.keys().hasAll([
          "id", "username", "nombre_publico", "bio", "color_primario",
          "is_online", "last_active_at", "created_at", "tipster_status"
        ])
        && request.resource.data.id == profileId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.nombre_publico is string
        && request.resource.data.nombre_publico.size() > 0
        && request.resource.data.nombre_publico.size() <= 60
        && (request.resource.data.bio == null
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 280))
        && request.resource.data.color_primario is string
        && request.resource.data.color_primario.size() == 7
        && request.resource.data.is_online is bool
        && (request.resource.data.last_active_at == null || request.resource.data.last_active_at is timestamp)
        && request.resource.data.created_at is timestamp
        && request.resource.data.tipster_status in ["approved", "revoked"];
    }

    // Full basic-profile validation is used when an admin creates or approves a profile.
    function validProfile(profileId) {
      return validProfileFields(profileId)
        && validUsername(request.resource.data.username)
        && request.resource.data.color_primario.matches('^#[0-9a-fA-F]{6}$');
    }

    function validProfileUpdate(profileId) {
      return validProfileFields(profileId)
        // Recheck expensive formats only when that field changes; type and size remain unconditional above.
        && (request.resource.data.username == resource.data.username
          || validUsername(request.resource.data.username))
        && (request.resource.data.color_primario == resource.data.color_primario
          || request.resource.data.color_primario.matches('^#[0-9a-fA-F]{6}$'));
    }

    function validSocialProfileFields() {
      return request.resource.data.keys().hasOnly([
          "avatar_url", "banner_url", "kick_url", "twitch_url",
          "youtube_url", "telegram_url", "twitter_url", "instagram_url"
        ])
        && request.resource.data.keys().hasAll([
          "avatar_url", "banner_url", "kick_url", "twitch_url",
          "youtube_url", "telegram_url", "twitter_url", "instagram_url"
        ])
        && (request.resource.data.avatar_url == null
          || (request.resource.data.avatar_url is string && request.resource.data.avatar_url.size() <= 204800))
        && (request.resource.data.banner_url == null
          || (request.resource.data.banner_url is string && request.resource.data.banner_url.size() <= 204800))
        && (request.resource.data.kick_url == null
          || (request.resource.data.kick_url is string && request.resource.data.kick_url.size() <= 2048))
        && (request.resource.data.twitch_url == null
          || (request.resource.data.twitch_url is string && request.resource.data.twitch_url.size() <= 2048))
        && (request.resource.data.youtube_url == null
          || (request.resource.data.youtube_url is string && request.resource.data.youtube_url.size() <= 2048))
        && (request.resource.data.telegram_url == null
          || (request.resource.data.telegram_url is string && request.resource.data.telegram_url.size() <= 2048))
        && (request.resource.data.twitter_url == null
          || (request.resource.data.twitter_url is string && request.resource.data.twitter_url.size() <= 2048))
        && (request.resource.data.instagram_url == null
          || (request.resource.data.instagram_url is string && request.resource.data.instagram_url.size() <= 2048));
    }

    function validSocialProfile() {
      return validSocialProfileFields()
        && validImage(request.resource.data.avatar_url)
        && validImage(request.resource.data.banner_url)
        && validOptionalHttpsUrl(request.resource.data.kick_url)
        && validOptionalHttpsUrl(request.resource.data.twitch_url)
        && validOptionalHttpsUrl(request.resource.data.youtube_url)
        && validOptionalHttpsUrl(request.resource.data.telegram_url)
        && validOptionalHttpsUrl(request.resource.data.twitter_url)
        && validOptionalHttpsUrl(request.resource.data.instagram_url);
    }

    function validSocialProfileUpdate() {
      return validSocialProfileFields()
        // Social URLs and image formats are rechecked only when changed; type and size always apply.
        && (request.resource.data.avatar_url == resource.data.avatar_url
          || validImage(request.resource.data.avatar_url))
        && (request.resource.data.banner_url == resource.data.banner_url
          || validImage(request.resource.data.banner_url))
        && (request.resource.data.kick_url == resource.data.kick_url
          || validOptionalHttpsUrl(request.resource.data.kick_url))
        && (request.resource.data.twitch_url == resource.data.twitch_url
          || validOptionalHttpsUrl(request.resource.data.twitch_url))
        && (request.resource.data.youtube_url == resource.data.youtube_url
          || validOptionalHttpsUrl(request.resource.data.youtube_url))
        && (request.resource.data.telegram_url == resource.data.telegram_url
          || validOptionalHttpsUrl(request.resource.data.telegram_url))
        && (request.resource.data.twitter_url == resource.data.twitter_url
          || validOptionalHttpsUrl(request.resource.data.twitter_url))
        && (request.resource.data.instagram_url == resource.data.instagram_url
          || validOptionalHttpsUrl(request.resource.data.instagram_url));
    }

    // Pronóstico schema is strict; legacy duplicate keys must be present and identical.
    function validPick(data, userId) {
      return data.keys().hasOnly([
          "user_id", "deporte", "evento", "seleccion", "prediccion", "cuota",
          "casa_de_apuestas", "casa_apuestas", "fecha_evento", "confianza",
          "nota", "destacada", "show_on_stream", "estado", "created_at"
        ])
        && data.keys().hasAll([
          "user_id", "deporte", "evento", "seleccion", "prediccion", "cuota",
          "casa_de_apuestas", "casa_apuestas", "fecha_evento", "confianza",
          "nota", "destacada", "show_on_stream", "estado", "created_at"
        ])
        && data.user_id == userId
        && data.deporte is string
        && data.deporte.size() > 0
        && data.deporte.size() <= 50
        && data.deporte in ["futbol", "baloncesto", "tenis", "beisbol", "esports", "otro"]
        && data.evento is string
        && data.evento.size() > 0
        && data.evento.size() <= 120
        && data.seleccion is string
        && data.seleccion.size() > 0
        && data.seleccion.size() <= 120
        && data.prediccion is string
        && data.prediccion.size() > 0
        && data.prediccion.size() <= 120
        && data.seleccion == data.prediccion
        && data.cuota is number
        && data.cuota >= 1.01
        && data.cuota <= 1000
        && data.casa_de_apuestas is string
        && data.casa_de_apuestas.size() > 0
        && data.casa_de_apuestas.size() <= 60
        && data.casa_de_apuestas in [
          "betano", "inkabet", "te_apuesto", "betsson",
          "doradobet", "apuesta_total", "bet365", "otra"
        ]
        && data.casa_apuestas is string
        && data.casa_apuestas.size() > 0
        && data.casa_apuestas.size() <= 60
        && data.casa_apuestas == data.casa_de_apuestas
        && data.fecha_evento is timestamp
        && (data.confianza == null
          || (data.confianza is int && data.confianza >= 1 && data.confianza <= 5))
        && (data.nota == null || (data.nota is string && data.nota.size() <= 500))
        && data.destacada is bool
        && data.show_on_stream is bool
        && data.estado in ["pendiente", "ganada", "perdida", "anulada"]
        && data.created_at is timestamp;
    }

    // Admin identity documents are provisioned out of band and never writable by clients.
    match /platformAdmins/{adminId} {
      allow read: if signedInAs(adminId);
      allow write: if false;
    }

    // Only the platform owner can change the bounded public configuration.
    match /platformSettings/{settingId} {
      allow read: if verifiedUser();
      allow create, update: if isPlatformAdmin()
        && settingId == "limits"
        && request.resource.data.keys().hasOnly([
          "tipsterMonthlyPickLimit", "viewerMonthlyPickLimit", "updated_at", "updated_by"
        ])
        && request.resource.data.tipsterMonthlyPickLimit is int
        && request.resource.data.tipsterMonthlyPickLimit >= 1
        && request.resource.data.tipsterMonthlyPickLimit <= 500
        && request.resource.data.viewerMonthlyPickLimit is int
        && request.resource.data.viewerMonthlyPickLimit >= 0
        && request.resource.data.viewerMonthlyPickLimit <= 500
        && request.resource.data.updated_at == request.time
        && request.resource.data.updated_by == request.auth.uid;
      allow delete: if false;
    }

    // Users may record their current legal acceptance once; neither party can rewrite it.
    match /legalAcceptances/{userId}/versions/{version} {
      allow read: if (request.auth != null && request.auth.uid == userId)
        || isPlatformAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "uid", "terms_version", "privacy_version", "age_confirmed", "accepted_at"
        ])
        && request.auth.uid == userId
        && version == "2026-10-03"
        && request.resource.data.uid == userId
        && request.resource.data.terms_version == version
        && request.resource.data.privacy_version == version
        && request.resource.data.age_confirmed == true
        && request.resource.data.accepted_at == request.time;
      allow update, delete: if false;
    }

    // Applicants manage their own request; only an admin can review its status.
    match /tipsterApplications/{userId} {
      allow read: if signedInAs(userId) || isPlatformAdmin();
      allow create: if signedInAs(userId)
        && acceptedCurrentTerms(userId)
        && request.resource.data.keys().hasOnly([
          "uid", "display_name", "email", "requested_username", "status",
          "submitted_at", "reviewed_at", "reviewed_by"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && validUsername(request.resource.data.requested_username)
        && request.resource.data.status == "pending"
        && request.resource.data.submitted_at == request.time
        && request.resource.data.reviewed_at == null
        && request.resource.data.reviewed_by == null
        && !profileIsApproved(userId)
        && (!exists(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username))
          || get(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username)).data.uid == userId);
      allow update: if (
          signedInAs(userId)
          && acceptedCurrentTerms(userId)
          && resource.data.status == "rejected"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "display_name", "email", "requested_username", "status",
            "submitted_at", "reviewed_at", "reviewed_by"
          ])
          && request.resource.data.uid == userId
          && request.resource.data.display_name is string
          && request.resource.data.display_name.size() > 0
          && request.resource.data.display_name.size() <= 60
          && request.resource.data.email == request.auth.token.email
          && validUsername(request.resource.data.requested_username)
          && request.resource.data.status == "pending"
          && request.resource.data.submitted_at == request.time
          && request.resource.data.reviewed_at == null
          && request.resource.data.reviewed_by == null
          && !profileIsApproved(userId)
          && (!exists(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username))
            || get(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username)).data.uid == userId)
        )
        || (
          isPlatformAdmin()
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewed_at", "reviewed_by"])
          && request.resource.data.status in ["approved", "rejected"]
          && request.resource.data.reviewed_at == request.time
          && request.resource.data.reviewed_by == request.auth.uid
          && (request.resource.data.status == "rejected"
            || approvedApplicationClaimsUsername(userId, resource.data.requested_username))
        );
      allow delete: if false;
    }

    // Profiles are public only while approved. TRANSITORIO: Sub-fase A.
    // En Sub-fase B, solo admin escribe.
    match /perfiles/{profileId} {
      allow read: if resource.data.tipster_status == "approved"
        || signedInAs(profileId)
        || isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validProfile(profileId)
        && request.resource.data.tipster_status == "approved"
        && request.resource.data.created_at == request.time
        && approvedApplicationClaimsUsername(profileId, request.resource.data.username);
      allow update: if (
          signedInAs(profileId)
          && acceptedCurrentTerms(profileId)
          && resource.data.tipster_status == "approved"
          && request.resource.data.tipster_status == resource.data.tipster_status
          && validProfileUpdate(profileId)
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "username", "nombre_publico", "bio", "color_primario",
            "is_online", "last_active_at"
          ])
          && ownsUsername(request.resource.data.username)
        )
        || (
          isPlatformAdmin()
          && (
            (
              resource.data.tipster_status in ["approved", "revoked"]
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tipster_status"])
              && request.resource.data.tipster_status in ["approved", "revoked"]
            )
            || (
              validProfile(profileId)
              && request.resource.data.tipster_status == "approved"
              && request.resource.data.created_at == resource.data.created_at
              && approvedApplicationClaimsUsername(profileId, request.resource.data.username)
            )
          )
        );
      allow delete: if false;
    }

    // TRANSITORIO: Sub-fase A. En Sub-fase B, solo admin escribe.
    // Public reads follow the approval state in perfiles/{uid}.
    match /perfiles_social/{profileId} {
      allow read: if profileIsApproved(profileId)
        || signedInAs(profileId)
        || isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validSocialProfile()
        && existsAfter(/databases/$(database)/documents/perfiles/$(profileId))
        && getAfter(/databases/$(database)/documents/perfiles/$(profileId)).data.tipster_status == "approved";
      allow update: if (
          signedInAs(profileId)
          && acceptedCurrentTerms(profileId)
          && profileIsApproved(profileId)
          && validSocialProfileUpdate()
        )
        || (isPlatformAdmin() && validSocialProfile());
      allow delete: if false;
    }

    // Usernames are public lookup keys but can only point to their profile owner.
    match /usernames/{username} {
      allow read: if true;
      allow create: if (
          signedInAs(request.resource.data.uid)
          && acceptedCurrentTerms(request.auth.uid)
          && request.resource.data.keys().hasOnly(["uid"])
          && validUsername(username)
          && profileOwnsUsername(request.resource.data.uid, username)
        )
        || (
          isPlatformAdmin()
          && request.resource.data.keys().hasOnly(["uid"])
          && validUsername(username)
          && approvedApplicationClaimsUsername(request.resource.data.uid, username)
        );
      allow update: if signedInAs(resource.data.uid)
        && acceptedCurrentTerms(request.auth.uid)
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == resource.data.uid
        && profileOwnsUsername(resource.data.uid, username);
      allow delete: if signedInAs(resource.data.uid)
        && acceptedCurrentTerms(request.auth.uid)
        && existsAfter(/databases/$(database)/documents/perfiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.username != username;
    }

    // Published picks are readable only when the owning tipster is approved.
    // Writes require the authenticated owner to have current approval.
    match /picks/{pickId} {
      allow read: if resource.data.user_id is string
        && profileIsApproved(resource.data.user_id);
      allow create: if verifiedUser()
        && acceptedCurrentTerms(request.auth.uid)
        && profileIsApproved(request.auth.uid)
        && validPick(request.resource.data, request.auth.uid)
        && request.resource.data.estado == "pendiente"
        && request.resource.data.created_at == request.time;
      allow update: if verifiedUser()
        && acceptedCurrentTerms(request.auth.uid)
        && profileIsApproved(request.auth.uid)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && validPick(request.resource.data, request.auth.uid)
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "deporte", "evento", "seleccion", "prediccion", "cuota",
          "casa_de_apuestas", "casa_apuestas", "fecha_evento",
          "confianza", "nota", "destacada", "show_on_stream", "estado"
        ]);
      allow delete: if verifiedUser()
        && acceptedCurrentTerms(request.auth.uid)
        && profileIsApproved(request.auth.uid)
        && resource.data.user_id == request.auth.uid;
    }
  }
}
