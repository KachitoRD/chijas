rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared identity and approval checks.
    function verifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("status", "active") == "active");
    }

    function signedInAs(userId) {
      return verifiedUser() && request.auth.uid == userId;
    }

    function acceptedCurrentTerms(userId) {
      let acceptance = get(/databases/$(database)/documents/legalAcceptances/$(userId)/versions/2026-10-03).data;
      return acceptance.terms_version == "2026-10-03"
        && acceptance.privacy_version == "2026-10-03";
    }

    function isPlatformAdmin() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && validAdminIdentity(get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data);
    }

    // A missing role preserves the out-of-band legacy owner ACL.
    function validAdminIdentity(data) {
      return data.enabled == true
        && data.get("role", "super_admin") in ["super_admin", "admin"];
    }

    function isSuperAdmin() {
      return isPlatformAdmin()
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.get("role", "super_admin") == "super_admin";
    }

    function hasAdminPermission(permission) {
      return isPlatformAdmin()
        && (isSuperAdmin()
          || permission in get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.get(
            "permissions", ["tipsters", "profiles", "viewers", "kpis"]));
    }

    function validAdminDocument(data) {
      return data.keys().hasOnly(["enabled", "role", "permissions", "updated_at", "updated_by"])
        && data.keys().hasAll(["enabled", "role", "permissions", "updated_at", "updated_by"])
        && data.enabled is bool
        && data.role in ["super_admin", "admin"]
        && data.permissions is list
        && data.permissions.size() <= 5
        && data.permissions.hasOnly(["tipsters", "profiles", "viewers", "kpis", "community"])
        && data.updated_at == request.time
        && data.updated_by == request.auth.uid;
    }

    function validUser(data, userId) {
      return data.keys().hasOnly(["uid", "role", "displayName", "photoURL", "email", "created_at",
          "status", "moderated_at", "moderated_by"])
        && data.keys().hasAll(["uid", "role", "displayName", "photoURL", "created_at"])
        && data.uid == userId && data.role == "viewer"
        && data.displayName is string && data.displayName.size() <= 120
        && validOptionalHttpsUrl(data.photoURL)
        && data.created_at is timestamp
        && (!data.keys().hasAny(["email"]) || (data.email is string && data.email.size() <= 254))
        && data.get("status", "active") in ["active", "suspended"]
        && (!data.keys().hasAny(["moderated_at"]) || data.moderated_at is timestamp)
        && (!data.keys().hasAny(["moderated_by"]) || (data.moderated_by is string && data.moderated_by.size() <= 128));
    }

    function profileIsApproved(userId) {
      return exists(/databases/$(database)/documents/perfiles/$(userId))
        && get(/databases/$(database)/documents/perfiles/$(userId)).data.tipster_status == "approved";
    }

    function pickExists(pickId) {
      return exists(/databases/$(database)/documents/picks/$(pickId));
    }

    function canReadMural(pickId) {
      let pick = get(/databases/$(database)/documents/picks/$(pickId)).data;
      return pickExists(pickId)
        && ((pick.user_id is string && profileIsApproved(pick.user_id))
          || hasAdminPermission("community"));
    }

    function canModerateMural(pickId) {
      let pick = get(/databases/$(database)/documents/picks/$(pickId)).data;
      return verifiedUser() && pickExists(pickId)
        && (pick.user_id == request.auth.uid || hasAdminPermission("community"));
    }

    function commentHasNoExternalLinks(text) {
      return !text.matches("(?i)[\\s\\S]*https?://[\\s\\S]*")
        && !text.matches("(?i)[\\s\\S]*www\\.[\\s\\S]*")
        && !text.matches("(?i)[\\s\\S]*\\b[a-z0-9-]+\\.[a-z]{2,}(/[^ ]*)?[\\s\\S]*")
        && !text.matches("(?i)[\\s\\S]*(t\\.me|telegram\\.me|wa\\.me|whatsapp\\.com|chat\\.whatsapp\\.com)[\\s\\S]*");
    }

    function muralAuthorName() {
      let name = request.auth.token.get("name", "");
      return name is string && name.size() > 0 ? name : "Miembro";
    }

    function validMuralComment(data, userId) {
      return data.keys().hasOnly(["authorUid", "authorName", "text", "created_at"])
        && data.keys().hasAll(["authorUid", "authorName", "text", "created_at"])
        && data.authorUid == userId
        && data.authorName is string
        && data.authorName.size() > 0 && data.authorName.size() <= 120
        && data.authorName == muralAuthorName()
        && data.text is string
        && data.text.size() > 0 && data.text.size() <= 500
        && data.text.matches("[\\s\\S]*\\S[\\s\\S]*")
        && commentHasNoExternalLinks(data.text)
        && data.created_at == request.time;
    }

    function validCommentRateLimit(data, userId) {
      let commentPath = /databases/$(database)/documents/picks/$(data.last_pick_id)/comments/$(data.last_comment_id);
      return data.keys().hasOnly(["last_at", "last_pick_id", "last_comment_id"])
        && data.keys().hasAll(["last_at", "last_pick_id", "last_comment_id"])
        && data.last_at == request.time
        && data.last_pick_id is string && data.last_pick_id.size() > 0 && data.last_pick_id.size() <= 128
        && data.last_comment_id is string && data.last_comment_id.size() > 0 && data.last_comment_id.size() <= 128
        && existsAfter(commentPath)
        && getAfter(commentPath).data.authorUid == userId
        && getAfter(commentPath).data.created_at == request.time;
    }

    function validMuralMute(pickId, mutedUid, data) {
      let sourcePath = /databases/$(database)/documents/picks/$(pickId)/comments/$(data.source_comment_id);
      return data.keys().hasOnly(["muted_uid", "source_comment_id", "created_by", "created_at"])
        && data.keys().hasAll(["muted_uid", "source_comment_id", "created_by", "created_at"])
        && data.muted_uid == mutedUid && mutedUid != request.auth.uid
        && data.source_comment_id is string && data.source_comment_id.size() > 0 && data.source_comment_id.size() <= 128
        && data.created_by == request.auth.uid
        && data.created_at == request.time
        && exists(sourcePath)
        && get(sourcePath).data.authorUid == mutedUid;
    }

    function validCommunityModerationSettings(data) {
      return data.keys().hasOnly(["blockedTerms", "updated_at", "updated_by"])
        && data.keys().hasAll(["blockedTerms", "updated_at", "updated_by"])
        && data.blockedTerms is string
        && data.blockedTerms.size() <= 2000
        && data.updated_at == request.time
        && data.updated_by == request.auth.uid;
    }

    function followerCount(data) {
      return data.get("followerCount", 0);
    }

    function validFollowCounter(profileId) {
      let followPath = /databases/$(database)/documents/follows/$(request.auth.uid + "_" + profileId);
      let before = exists(followPath);
      let after = existsAfter(followPath);
      return signedInAs(request.auth.uid)
        && acceptedCurrentTerms(request.auth.uid)
        && resource.data.tipster_status == "approved"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["followerCount", "followerCountUpdatedBy"])
        && request.resource.data.followerCountUpdatedBy == request.auth.uid
        && request.resource.data.followerCount is int
        && request.resource.data.followerCount >= 0
        && (( !before && after
            && getAfter(followPath).data.followerId == request.auth.uid
            && getAfter(followPath).data.tipsterId == profileId
            && request.resource.data.followerCount == followerCount(resource.data) + 1)
          || (before && !after
            && get(followPath).data.followerId == request.auth.uid
            && get(followPath).data.tipsterId == profileId
            && request.resource.data.followerCount == followerCount(resource.data) - 1));
    }

    // Username claims must match the profile and application written in the same transaction.
    function ownsUsername(username) {
      return existsAfter(/databases/$(database)/documents/usernames/$(username))
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    function profileOwnsUsername(userId, username) {
      return existsAfter(/databases/$(database)/documents/perfiles/$(userId))
        && getAfter(/databases/$(database)/documents/perfiles/$(userId)).data.tipster_status == "approved"
        && getAfter(/databases/$(database)/documents/perfiles/$(userId)).data.username == username;
    }

    function approvedApplicationClaimsUsername(userId, username) {
      return existsAfter(/databases/$(database)/documents/tipsterApplications/$(userId))
        && getAfter(/databases/$(database)/documents/tipsterApplications/$(userId)).data.status == "approved"
        && getAfter(/databases/$(database)/documents/tipsterApplications/$(userId)).data.requested_username == username
        && profileOwnsUsername(userId, username);
    }

    // URL fields accept only absolute HTTPS URLs; embedded JPEGs are not outbound links.
    function validUsername(username) {
      return username is string && username.matches('^[a-z0-9_-]{3,30}$');
    }

    function validHttpsUrl(value) {
      return value is string && value.size() <= 2048 && value.matches('^https://.+$');
    }

    function validOptionalHttpsUrl(value) {
      return value == null || validHttpsUrl(value);
    }

    function validImage(value) {
      return value == null
        || validHttpsUrl(value)
        || (value is string
          && value.size() <= 204800
          && value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'));
    }

    function validProfileFields(profileId) {
      return request.resource.data.keys().hasOnly([
          "id", "username", "nombre_publico", "bio", "color_primario",
          "is_online", "last_active_at", "created_at", "tipster_status",
          "followerCount", "followerCountUpdatedBy"
        ])
        && request.resource.data.keys().hasAll([
          "id", "username", "nombre_publico", "bio", "color_primario",
          "is_online", "last_active_at", "created_at", "tipster_status"
        ])
        && request.resource.data.id == profileId
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.nombre_publico is string
        && request.resource.data.nombre_publico.size() > 0
        && request.resource.data.nombre_publico.size() <= 60
        && (request.resource.data.bio == null
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 280))
        && request.resource.data.color_primario is string
        && request.resource.data.color_primario.size() == 7
        && request.resource.data.is_online is bool
        && (request.resource.data.last_active_at == null || request.resource.data.last_active_at is timestamp)
        && request.resource.data.created_at is timestamp
        && request.resource.data.tipster_status in ["approved", "revoked"]
        && followerCount(request.resource.data) is int
        && followerCount(request.resource.data) >= 0
        && (!request.resource.data.keys().hasAny(["followerCountUpdatedBy"])
          || request.resource.data.followerCountUpdatedBy is string);
    }

    // Full basic-profile validation is used when an admin creates or approves a profile.
    function validProfile(profileId) {
      return validProfileFields(profileId)
        && validUsername(request.resource.data.username)
        && request.resource.data.color_primario.matches('^#[0-9a-fA-F]{6}$');
    }

    function validProfileUpdate(profileId) {
      return validProfileFields(profileId)
        // Recheck expensive formats only when that field changes; type and size remain unconditional above.
        && (request.resource.data.username == resource.data.username
          || validUsername(request.resource.data.username))
        && (request.resource.data.color_primario == resource.data.color_primario
          || request.resource.data.color_primario.matches('^#[0-9a-fA-F]{6}$'));
    }

    function validSocialProfileFields() {
      return request.resource.data.keys().hasOnly([
          "avatar_url", "banner_url", "kick_url", "twitch_url",
          "youtube_url", "telegram_url", "twitter_url", "instagram_url"
        ])
        && request.resource.data.keys().hasAll([
          "avatar_url", "banner_url", "kick_url", "twitch_url",
          "youtube_url", "telegram_url", "twitter_url", "instagram_url"
        ])
        && (request.resource.data.avatar_url == null
          || (request.resource.data.avatar_url is string && request.resource.data.avatar_url.size() <= 204800))
        && (request.resource.data.banner_url == null
          || (request.resource.data.banner_url is string && request.resource.data.banner_url.size() <= 204800))
        && (request.resource.data.kick_url == null
          || (request.resource.data.kick_url is string && request.resource.data.kick_url.size() <= 2048))
        && (request.resource.data.twitch_url == null
          || (request.resource.data.twitch_url is string && request.resource.data.twitch_url.size() <= 2048))
        && (request.resource.data.youtube_url == null
          || (request.resource.data.youtube_url is string && request.resource.data.youtube_url.size() <= 2048))
        && (request.resource.data.telegram_url == null
          || (request.resource.data.telegram_url is string && request.resource.data.telegram_url.size() <= 2048))
        && (request.resource.data.twitter_url == null
          || (request.resource.data.twitter_url is string && request.resource.data.twitter_url.size() <= 2048))
        && (request.resource.data.instagram_url == null
          || (request.resource.data.instagram_url is string && request.resource.data.instagram_url.size() <= 2048));
    }

    function validSocialProfile() {
      return validSocialProfileFields()
        && validImage(request.resource.data.avatar_url)
        && validImage(request.resource.data.banner_url)
        && validOptionalHttpsUrl(request.resource.data.kick_url)
        && validOptionalHttpsUrl(request.resource.data.twitch_url)
        && validOptionalHttpsUrl(request.resource.data.youtube_url)
        && validOptionalHttpsUrl(request.resource.data.telegram_url)
        && validOptionalHttpsUrl(request.resource.data.twitter_url)
        && validOptionalHttpsUrl(request.resource.data.instagram_url);
    }

    function validSocialProfileUpdate() {
      return validSocialProfileFields()
        // Social URLs and image formats are rechecked only when changed; type and size always apply.
        && (request.resource.data.avatar_url == resource.data.avatar_url
          || validImage(request.resource.data.avatar_url))
        && (request.resource.data.banner_url == resource.data.banner_url
          || validImage(request.resource.data.banner_url))
        && (request.resource.data.kick_url == resource.data.kick_url
          || validOptionalHttpsUrl(request.resource.data.kick_url))
        && (request.resource.data.twitch_url == resource.data.twitch_url
          || validOptionalHttpsUrl(request.resource.data.twitch_url))
        && (request.resource.data.youtube_url == resource.data.youtube_url
          || validOptionalHttpsUrl(request.resource.data.youtube_url))
        && (request.resource.data.telegram_url == resource.data.telegram_url
          || validOptionalHttpsUrl(request.resource.data.telegram_url))
        && (request.resource.data.twitter_url == resource.data.twitter_url
          || validOptionalHttpsUrl(request.resource.data.twitter_url))
        && (request.resource.data.instagram_url == resource.data.instagram_url
          || validOptionalHttpsUrl(request.resource.data.instagram_url));
    }

    function validSocialProfileApply() {
      return validSocialProfileFields();
    }

    function validProfileChanges(changes) {
      return changes is map
        && changes.keys().hasOnly([
          "username", "nombre_publico", "bio", "color_primario",
          "avatar_url", "banner_url", "kick_url", "twitch_url",
          "youtube_url", "telegram_url", "twitter_url", "instagram_url"
        ])
        && changes.keys().hasAny([
          "username", "nombre_publico", "bio", "color_primario",
          "avatar_url", "banner_url", "kick_url", "twitch_url",
          "youtube_url", "telegram_url", "twitter_url", "instagram_url"
        ])
        && (!changes.keys().hasAny(["username"]) || validUsername(changes.username))
        && (!changes.keys().hasAny(["nombre_publico"])
          || (changes.nombre_publico is string
            && changes.nombre_publico.size() > 0
            && changes.nombre_publico.size() <= 60))
        && (!changes.keys().hasAny(["bio"])
          || changes.bio == null
          || (changes.bio is string && changes.bio.size() <= 280))
        && (!changes.keys().hasAny(["color_primario"])
          || (changes.color_primario is string
            && changes.color_primario.matches('^#[0-9a-fA-F]{6}$')))
        && (!changes.keys().hasAny(["avatar_url"])
          || changes.avatar_url == null || validImage(changes.avatar_url))
        && (!changes.keys().hasAny(["banner_url"])
          || changes.banner_url == null || validImage(changes.banner_url))
        && (!changes.keys().hasAny(["kick_url"])
          || changes.kick_url == null || validHttpsUrl(changes.kick_url))
        && (!changes.keys().hasAny(["twitch_url"])
          || changes.twitch_url == null || validHttpsUrl(changes.twitch_url))
        && (!changes.keys().hasAny(["youtube_url"])
          || changes.youtube_url == null || validHttpsUrl(changes.youtube_url))
        && (!changes.keys().hasAny(["telegram_url"])
          || changes.telegram_url == null || validHttpsUrl(changes.telegram_url))
        && (!changes.keys().hasAny(["twitter_url"])
          || changes.twitter_url == null || validHttpsUrl(changes.twitter_url))
        && (!changes.keys().hasAny(["instagram_url"])
          || changes.instagram_url == null || validHttpsUrl(changes.instagram_url));
    }

    function validProfileRequest(userId, requestId, data) {
      return data.keys().hasOnly([
          "uid", "cambios", "estado", "motivoRechazo",
          "created_at", "revisado_at", "revisado_por"
        ])
        && data.keys().hasAll([
          "uid", "cambios", "estado", "motivoRechazo",
          "created_at", "revisado_at", "revisado_por"
        ])
        && data.uid == userId
        && validProfileChanges(data.cambios)
        && data.estado == "pendiente"
        && data.motivoRechazo == null
        && data.created_at == request.time
        && data.revisado_at == null
        && data.revisado_por == null
        && requestId is string;
    }

    function applyingApprovedProfileRequest(userId) {
      let reservation = get(/databases/$(database)/documents/perfilSolicitudesPendientes/$(userId)).data;
      let profileRequest = getAfter(/databases/$(database)/documents/perfilSolicitudes/$(reservation.solicitud_id)).data;
      return reservation.uid == userId
        && reservation.solicitud_id is string
        && profileRequest.uid == userId
        && profileRequest.estado == "aprobada"
        && profileRequest.revisado_por == request.auth.uid;
    }

    function validPresence(userId) {
      return request.resource.data.keys().hasOnly(["uid", "is_online", "last_active_at"])
        && request.resource.data.keys().hasAll(["uid", "is_online", "last_active_at"])
        && request.resource.data.uid == userId
        && request.resource.data.is_online is bool
        && (request.resource.data.last_active_at == request.time
          || request.resource.data.last_active_at is timestamp);
    }

    function pickStatus(data) {
      let legacy = data.get("estado", "");
      return data.get("status", legacy == "pendiente" ? "pending"
        : legacy == "ganada" ? "won" : legacy == "perdida" ? "lost"
          : legacy == "anulada" ? "void" : legacy == "cash_out" ? "cashed_out" : "invalid");
    }

    function pickEventDate(data) {
      return data.get("event_date", data.get("fecha_evento", data.get("event_start_at", timestamp.date(1970, 1, 1))));
    }

    function samePickTerms(before, after) {
      return after.event_date == pickEventDate(before)
        && after.sport == before.get("sport", before.get("deporte", ""))
        && after.event == before.get("event", before.get("evento", ""))
        && after.selection == before.get("selection", before.get("seleccion", before.get("prediccion", before.get("pronostico", ""))))
        && after.odds == before.get("odds", before.get("cuota", 0))
        && after.bookmaker == before.get("bookmaker", before.get("casa_de_apuestas", before.get("casa_apuestas", "")))
        && after.league == before.get("league", "")
        && after.market == before.get("market", "")
        && after.stake == before.get("stake", null)
        && after.analysis == before.get("analysis", before.get("nota", "") == null ? "" : before.get("nota", ""))
        && after.confianza == before.get("confianza", null)
        && after.destacada == before.get("destacada", false)
        && after.show_on_stream == before.get("show_on_stream", false);
    }

    function validPublicCashOut(data) {
      return data.status == "cashed_out"
        ? (data.keys().hasAny(["cashout_value"]) && !data.keys().hasAny(["cashout_odds"])
            && data.cashout_value is number && data.cashout_value >= 0 && data.cashout_value <= 10000000)
          || (data.keys().hasAny(["cashout_odds"]) && !data.keys().hasAny(["cashout_value"])
            && data.cashout_odds is number && data.cashout_odds >= 0 && data.cashout_odds <= 1000)
        : !data.keys().hasAny(["cashout_value", "cashout_odds"]);
    }

    // Canonical public units only. Monetary stake and return remain in private/bankroll.
    function validPick(data, userId) {
      return data.keys().hasOnly([
          "user_id", "sport", "event", "selection", "odds", "bookmaker", "event_date",
          "league", "market", "stake", "analysis", "status", "cashout_value", "cashout_odds",
          "confianza", "destacada", "show_on_stream", "created_at"
        ])
        && data.keys().hasAll([
          "user_id", "sport", "event", "selection", "odds", "bookmaker", "event_date",
          "league", "market", "stake", "analysis", "status",
          "confianza", "destacada", "show_on_stream", "created_at"
        ])
        && data.user_id == userId
        && data.sport in ["futbol", "baloncesto", "tenis", "beisbol", "esports", "otro"]
        && data.event is string && data.event.size() > 0 && data.event.size() <= 120
        && data.selection is string && data.selection.size() > 0 && data.selection.size() <= 120
        && data.odds is number && data.odds >= 1.01 && data.odds <= 1000
        && data.league is string && data.league.size() <= 120
        && data.market is string && data.market.size() <= 120
        && (data.stake == null || (data.stake is number && data.stake > 0 && data.stake <= 10000))
        && data.bookmaker in [
          "betano", "inkabet", "te_apuesto", "betsson",
          "doradobet", "apuesta_total", "bet365", "otra"
        ]
        && data.event_date is timestamp
        && (data.confianza == null
          || (data.confianza is int && data.confianza >= 1 && data.confianza <= 5))
        && data.analysis is string && data.analysis.size() <= 4000
        && data.destacada is bool
        && data.show_on_stream is bool
        && data.status in ["pending", "won", "lost", "void", "cashed_out"]
        && validPublicCashOut(data)
        && data.created_at is timestamp;
    }

    // Bootstrap is out of band; only a super_admin can manage other identities.
    match /platformAdmins/{adminId} {
      allow read: if signedInAs(adminId) || isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && adminId != request.auth.uid
        && adminId.size() > 0 && adminId.size() <= 128
        && validAdminDocument(request.resource.data)
        && (!exists(/databases/$(database)/documents/users/$(adminId))
          || get(/databases/$(database)/documents/users/$(adminId)).data.get("status", "active") == "active");
      allow delete: if false;
    }

    // Global government is exclusively super_admin.
    match /platformSettings/{settingId} {
      allow read: if verifiedUser();
      allow create, update: if isSuperAdmin()
        && settingId == "limits"
        && request.resource.data.keys().hasOnly([
          "tipsterMonthlyPickLimit", "viewerMonthlyPickLimit", "updated_at", "updated_by"
        ])
        && request.resource.data.tipsterMonthlyPickLimit is int
        && request.resource.data.tipsterMonthlyPickLimit >= 1
        && request.resource.data.tipsterMonthlyPickLimit <= 500
        && request.resource.data.viewerMonthlyPickLimit is int
        && request.resource.data.viewerMonthlyPickLimit >= 0
        && request.resource.data.viewerMonthlyPickLimit <= 500
        && request.resource.data.updated_at == request.time
        && request.resource.data.updated_by == request.auth.uid
        || hasAdminPermission("community")
          && settingId == "communityModeration"
          && validCommunityModerationSettings(request.resource.data);
      allow delete: if false;
    }

    // Comments and mutes are scoped to a published pick; rate state is per verified account.
    match /picks/{pickId}/comments/{commentId} {
      function validCommentRateLink(userId) {
        let ratePath = /databases/$(database)/documents/commentRateLimits/$(userId);
        return existsAfter(ratePath)
          && getAfter(ratePath).data.last_at == request.time
          && getAfter(ratePath).data.last_pick_id == pickId
          && getAfter(ratePath).data.last_comment_id == commentId;
      }
      function validCommentAuthorAccount(userId) {
        let userPath = /databases/$(database)/documents/users/$(userId);
        return exists(userPath)
          && get(userPath).data.role == "viewer"
          && get(userPath).data.get("status", "active") == "active";
      }
      allow read: if canReadMural(pickId);
      allow create: if verifiedUser()
        && request.auth.token.email_verified == true
        && acceptedCurrentTerms(request.auth.uid)
        && validCommentAuthorAccount(request.auth.uid)
        && profileIsApproved(get(/databases/$(database)/documents/picks/$(pickId)).data.user_id)
        && !exists(/databases/$(database)/documents/picks/$(pickId)/commentMutes/$(request.auth.uid))
        && validMuralComment(request.resource.data, request.auth.uid)
        && validCommentRateLink(request.auth.uid);
      allow update: if false;
      allow delete: if verifiedUser()
        && (resource.data.authorUid == request.auth.uid || canModerateMural(pickId));
    }

    match /picks/{pickId}/commentMutes/{mutedUid} {
      allow read: if signedInAs(mutedUid) || canModerateMural(pickId);
      allow create: if canModerateMural(pickId)
        && validMuralMute(pickId, mutedUid, request.resource.data);
      allow update: if false;
      allow delete: if canModerateMural(pickId);
    }

    match /commentRateLimits/{userId} {
      function rateLimitIntervalElapsed() {
        return resource.data.last_at is timestamp
          && request.time >= resource.data.last_at + duration.value(10, "s");
      }
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && validCommentRateLimit(request.resource.data, userId);
      allow update: if signedInAs(userId)
        && rateLimitIntervalElapsed()
        && validCommentRateLimit(request.resource.data, userId);
      allow delete: if false;
    }

    // Users may record their current legal acceptance once; neither party can rewrite it.
    match /legalAcceptances/{userId}/versions/{version} {
      allow read: if (request.auth != null && request.auth.uid == userId)
        || isPlatformAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "uid", "terms_version", "privacy_version", "age_confirmed", "accepted_at"
        ])
        && request.auth.uid == userId
        && version == "2026-10-03"
        && request.resource.data.uid == userId
        && request.resource.data.terms_version == version
        && request.resource.data.privacy_version == version
        && request.resource.data.age_confirmed == true
        && request.resource.data.accepted_at == request.time;
      allow update, delete: if false;
    }

    // Applicants manage their own request; only an admin can review its status.
    match /tipsterApplications/{userId} {
      allow read: if signedInAs(userId) || hasAdminPermission("tipsters");
      allow create: if signedInAs(userId)
        && acceptedCurrentTerms(userId)
        && request.resource.data.keys().hasOnly([
          "uid", "display_name", "email", "requested_username", "status",
          "submitted_at", "reviewed_at", "reviewed_by"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && validUsername(request.resource.data.requested_username)
        && request.resource.data.status == "pending"
        && request.resource.data.submitted_at == request.time
        && request.resource.data.reviewed_at == null
        && request.resource.data.reviewed_by == null
        && !profileIsApproved(userId)
        && (!exists(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username))
          || get(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username)).data.uid == userId);
      allow update: if (
          signedInAs(userId)
          && acceptedCurrentTerms(userId)
          && resource.data.status == "rejected"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "display_name", "email", "requested_username", "status",
            "submitted_at", "reviewed_at", "reviewed_by"
          ])
          && request.resource.data.uid == userId
          && request.resource.data.display_name is string
          && request.resource.data.display_name.size() > 0
          && request.resource.data.display_name.size() <= 60
          && request.resource.data.email == request.auth.token.email
          && validUsername(request.resource.data.requested_username)
          && request.resource.data.status == "pending"
          && request.resource.data.submitted_at == request.time
          && request.resource.data.reviewed_at == null
          && request.resource.data.reviewed_by == null
          && !profileIsApproved(userId)
          && (!exists(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username))
            || get(/databases/$(database)/documents/usernames/$(request.resource.data.requested_username)).data.uid == userId)
        )
        || (
          hasAdminPermission("tipsters")
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewed_at", "reviewed_by"])
          && request.resource.data.status in ["approved", "rejected"]
          && request.resource.data.reviewed_at == request.time
          && request.resource.data.reviewed_by == request.auth.uid
          && (request.resource.data.status == "rejected"
            || approvedApplicationClaimsUsername(userId, resource.data.requested_username))
        );
      allow delete: if false;
    }

    // Profiles are public only while approved and are writable only by admins.
    match /perfiles/{profileId} {
      allow read: if resource.data.tipster_status == "approved"
        || signedInAs(profileId)
        || isPlatformAdmin();
      allow create: if hasAdminPermission("tipsters")
        && validProfile(profileId)
        && request.resource.data.tipster_status == "approved"
        && request.resource.data.created_at == request.time
        && approvedApplicationClaimsUsername(profileId, request.resource.data.username);
      allow update: if validFollowCounter(profileId) || (isPlatformAdmin()
        && (
          (
            resource.data.tipster_status in ["approved", "revoked"]
            && hasAdminPermission("tipsters")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tipster_status"])
            && request.resource.data.tipster_status in ["approved", "revoked"]
          )
          || (
            resource.data.tipster_status == "pending"
            && hasAdminPermission("tipsters")
            && validProfile(profileId)
            && request.resource.data.tipster_status == "approved"
            && request.resource.data.created_at == resource.data.created_at
            && approvedApplicationClaimsUsername(profileId, request.resource.data.username)
          )
          || (
            resource.data.tipster_status == "approved"
            && hasAdminPermission("profiles")
            && request.resource.data.tipster_status == resource.data.tipster_status
            && validProfile(profileId)
            && request.resource.data.created_at == resource.data.created_at
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "username", "nombre_publico", "bio", "color_primario",
              "is_online", "last_active_at"
            ])
            && applyingApprovedProfileRequest(profileId)
          )
        ));
      allow delete: if false;
    }

    // Public presentation only: visible (bool) and server-owned updated_at (timestamp).
    // The profile path owns the selection; the pick terms and result remain untouched.
    match /perfiles/{profileId}/obsSelections/{pickId} {
      function canManageSelection() {
        return signedInAs(profileId)
          && acceptedCurrentTerms(profileId)
          && profileIsApproved(profileId);
      }
      function validSelection() {
        let data = request.resource.data;
        let pickPath = /databases/$(database)/documents/picks/$(pickId);
        return data.keys().hasAll(["visible", "updated_at"])
          && data.keys().hasOnly(["visible", "updated_at"])
          && data.visible is bool
          && data.updated_at is timestamp
          && data.updated_at == request.time
          && existsAfter(pickPath)
          && getAfter(pickPath).data.user_id == profileId;
      }
      allow read: if profileIsApproved(profileId);
      allow create, update: if canManageSelection() && validSelection();
      allow delete: if canManageSelection();
    }

    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId)
        || (hasAdminPermission("viewers") && resource.data.role == "viewer");
      allow create: if signedInAs(userId)
        && validUser(request.resource.data, userId)
        && request.resource.data.get("status", "active") == "active"
        && !request.resource.data.keys().hasAny(["moderated_at", "moderated_by"])
        && request.resource.data.get("email", request.auth.token.email) == request.auth.token.email
        && request.resource.data.created_at == request.time;
      allow update: if hasAdminPermission("viewers")
        && userId != request.auth.uid
        && (!exists(/databases/$(database)/documents/platformAdmins/$(userId))
          || get(/databases/$(database)/documents/platformAdmins/$(userId)).data.enabled != true)
        && validUser(request.resource.data, userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "moderated_at", "moderated_by"])
        && request.resource.data.moderated_at == request.time
        && request.resource.data.moderated_by == request.auth.uid;
      allow delete: if false;

      // Private viewer identity/preferences; never grants roles or changes editorial profiles.
      match /settings/{settingId} {
        function validViewerSettings(data) {
          return data.keys().hasOnly(["displayName", "photoURL", "bio", "theme", "notifications", "updated_at"])
            && data.keys().hasAll(["displayName", "photoURL", "bio", "theme", "notifications", "updated_at"])
            && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120
            && validOptionalHttpsUrl(data.photoURL)
            && data.bio is string && data.bio.size() <= 280
            && data.theme in ["emerald", "contrast"]
            && data.notifications is bool
            && data.updated_at == request.time;
        }
        allow read: if request.auth != null && request.auth.uid == userId && settingId == "profile";
        allow create, update: if signedInAs(userId) && settingId == "profile"
          && exists(/databases/$(database)/documents/users/$(userId))
          && validViewerSettings(request.resource.data);
        allow delete: if false;
      }
    }

    // Private heartbeat; connection counts are estimates, not Auth session counts.
    match /viewerPresence/{userId} {
      function validViewerPresence() {
        return request.resource.data.keys().hasOnly(["uid", "is_online", "last_active_at"])
          && request.resource.data.keys().hasAll(["uid", "is_online", "last_active_at"])
          && request.resource.data.uid == userId
          && request.resource.data.is_online is bool
          && request.resource.data.last_active_at == request.time;
      }
      allow read: if signedInAs(userId) || hasAdminPermission("viewers") || hasAdminPermission("kpis");
      allow create, update: if validViewerPresence()
        && ((signedInAs(userId)
            && exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.role == "viewer")
          || (hasAdminPermission("viewers")
            && request.resource.data.is_online == false
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.status == "suspended"
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.moderated_by == request.auth.uid
            && getAfter(/databases/$(database)/documents/users/$(userId)).data.moderated_at == request.time));
      allow delete: if false;
    }

    // Percentage configuration only: no bankroll or invented monetary balances.
    match /tipsterFinance/{userId} {
      function validTakeRate() {
        return request.resource.data.keys().hasOnly(["takeRate", "updated_at", "updated_by"])
          && request.resource.data.keys().hasAll(["takeRate", "updated_at", "updated_by"])
          && request.resource.data.takeRate is number
          && request.resource.data.takeRate >= 0 && request.resource.data.takeRate <= 100
          && request.resource.data.updated_at == request.time
          && request.resource.data.updated_by == request.auth.uid;
      }
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && profileIsApproved(userId) && validTakeRate();
      allow delete: if false;
    }

    match /follows/{followId} {
      function validCounterChange(tipsterId, delta) {
        let path = /databases/$(database)/documents/perfiles/$(tipsterId);
        return profileIsApproved(tipsterId)
          && getAfter(path).data.followerCountUpdatedBy == request.auth.uid
          && getAfter(path).data.followerCount == followerCount(get(path).data) + delta;
      }
      // Owners can also read their absent deterministic document before creating it.
      allow get: if verifiedUser()
        && (resource == null || resource.data.followerId == request.auth.uid);
      allow list: if verifiedUser() && resource.data.followerId == request.auth.uid;
      allow create: if signedInAs(request.resource.data.followerId)
        && acceptedCurrentTerms(request.auth.uid)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(["followerId", "tipsterId", "created_at"])
        && request.resource.data.keys().hasAll(["followerId", "tipsterId", "created_at"])
        && request.resource.data.tipsterId is string
        && followId == request.auth.uid + "_" + request.resource.data.tipsterId
        && request.resource.data.created_at == request.time
        && validCounterChange(request.resource.data.tipsterId, 1);
      allow delete: if signedInAs(resource.data.followerId)
        && acceptedCurrentTerms(request.auth.uid)
        && followId == request.auth.uid + "_" + resource.data.tipsterId
        && validCounterChange(resource.data.tipsterId, -1);
      allow update: if false;
    }

    // Social profile data is public only while its basic profile is approved.
    match /perfiles_social/{profileId} {
      allow read: if profileIsApproved(profileId)
        || signedInAs(profileId)
        || isPlatformAdmin();
      allow create: if hasAdminPermission("tipsters")
        && validSocialProfile()
        && existsAfter(/databases/$(database)/documents/perfiles/$(profileId))
        && getAfter(/databases/$(database)/documents/perfiles/$(profileId)).data.tipster_status == "approved";
      allow update: if hasAdminPermission("profiles")
        && (
          (
            profileIsApproved(profileId)
            && validSocialProfileApply()
            && applyingApprovedProfileRequest(profileId)
          )
          || (
            exists(/databases/$(database)/documents/perfiles/$(profileId))
            && get(/databases/$(database)/documents/perfiles/$(profileId)).data.tipster_status == "pending"
            && validSocialProfile()
            && approvedApplicationClaimsUsername(
              profileId,
              getAfter(/databases/$(database)/documents/tipsterApplications/$(profileId)).data.requested_username
            )
          )
        );
      allow delete: if false;
    }

    // Tipsters submit validated profile changes; admins make the final decision.
    match /perfilSolicitudes/{requestId} {
      allow read: if signedInAs(resource.data.uid) || hasAdminPermission("profiles");
      allow create: if signedInAs(request.resource.data.uid)
        && acceptedCurrentTerms(request.resource.data.uid)
        && profileIsApproved(request.resource.data.uid)
        && validProfileRequest(request.resource.data.uid, requestId, request.resource.data)
        && existsAfter(/databases/$(database)/documents/perfilSolicitudesPendientes/$(request.resource.data.uid))
        && getAfter(/databases/$(database)/documents/perfilSolicitudesPendientes/$(request.resource.data.uid)).data.solicitud_id == requestId;
      allow update: if hasAdminPermission("profiles")
        && resource.data.estado == "pendiente"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "motivoRechazo", "revisado_at", "revisado_por"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.cambios == resource.data.cambios
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.estado in ["aprobada", "rechazada"]
        && request.resource.data.revisado_at == request.time
        && request.resource.data.revisado_por == request.auth.uid
        && ((request.resource.data.estado == "aprobada" && request.resource.data.motivoRechazo == null)
          || (request.resource.data.estado == "rechazada"
            && request.resource.data.motivoRechazo is string
            && request.resource.data.motivoRechazo.size() > 0
            && request.resource.data.motivoRechazo.size() <= 500))
        && exists(/databases/$(database)/documents/perfilSolicitudesPendientes/$(resource.data.uid))
        && get(/databases/$(database)/documents/perfilSolicitudesPendientes/$(resource.data.uid)).data.solicitud_id == requestId;
      allow delete: if false;
    }

    // A per-tipster reservation makes a second pending request impossible.
    match /perfilSolicitudesPendientes/{userId} {
      allow read: if signedInAs(userId) || hasAdminPermission("profiles");
      allow create: if signedInAs(userId)
        && acceptedCurrentTerms(userId)
        && profileIsApproved(userId)
        && request.resource.data.keys().hasOnly(["uid", "solicitud_id", "created_at"])
        && request.resource.data.keys().hasAll(["uid", "solicitud_id", "created_at"])
        && request.resource.data.uid == userId
        && request.resource.data.solicitud_id is string
        && request.resource.data.created_at == request.time
        && existsAfter(/databases/$(database)/documents/perfilSolicitudes/$(request.resource.data.solicitud_id))
        && validProfileRequest(
          userId,
          request.resource.data.solicitud_id,
          getAfter(/databases/$(database)/documents/perfilSolicitudes/$(request.resource.data.solicitud_id)).data
        );
      allow update: if false;
      allow delete: if hasAdminPermission("profiles")
        && getAfter(/databases/$(database)/documents/perfilSolicitudes/$(resource.data.solicitud_id)).data.uid == resource.data.uid
        && getAfter(/databases/$(database)/documents/perfilSolicitudes/$(resource.data.solicitud_id)).data.estado in ["aprobada", "rechazada"]
        && getAfter(/databases/$(database)/documents/perfilSolicitudes/$(resource.data.solicitud_id)).data.revisado_por == request.auth.uid;
    }

    // Presence is separate from the admin-managed public profile.
    match /presencia/{userId} {
      allow read: if profileIsApproved(userId) || signedInAs(userId) || isPlatformAdmin();
      allow create: if (hasAdminPermission("tipsters")
          && validPresence(userId)
          && existsAfter(/databases/$(database)/documents/perfiles/$(userId))
          && getAfter(/databases/$(database)/documents/perfiles/$(userId)).data.tipster_status == "approved")
        || (signedInAs(userId)
          && acceptedCurrentTerms(userId)
          && profileIsApproved(userId)
          && validPresence(userId));
      allow update: if signedInAs(userId)
        && acceptedCurrentTerms(userId)
        && profileIsApproved(userId)
        && validPresence(userId);
      allow delete: if false;
    }

    // Usernames are public lookup keys but can only point to their profile owner.
    match /usernames/{username} {
      allow read: if true;
      allow create: if (
          signedInAs(request.resource.data.uid)
          && acceptedCurrentTerms(request.auth.uid)
          && request.resource.data.keys().hasOnly(["uid"])
          && validUsername(username)
          && profileOwnsUsername(request.resource.data.uid, username)
        )
        || (
          isPlatformAdmin()
          && request.resource.data.keys().hasOnly(["uid"])
          && validUsername(username)
          && approvedApplicationClaimsUsername(request.resource.data.uid, username)
        )
        || (isPlatformAdmin()
          && request.resource.data.keys().hasOnly(["uid"])
          && request.resource.data.uid is string
          && profileOwnsUsername(request.resource.data.uid, username)
          && applyingApprovedProfileRequest(request.resource.data.uid));
      allow update: if signedInAs(resource.data.uid)
        && acceptedCurrentTerms(request.auth.uid)
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == resource.data.uid
        && profileOwnsUsername(resource.data.uid, username)
        || isPlatformAdmin()
          && request.resource.data.keys().hasOnly(["uid"])
          && request.resource.data.uid == resource.data.uid
          && profileOwnsUsername(resource.data.uid, username)
          && applyingApprovedProfileRequest(resource.data.uid);
      allow delete: if signedInAs(resource.data.uid)
        && acceptedCurrentTerms(request.auth.uid)
        && existsAfter(/databases/$(database)/documents/perfiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.username != username
        || isPlatformAdmin()
          && existsAfter(/databases/$(database)/documents/perfiles/$(resource.data.uid))
          && getAfter(/databases/$(database)/documents/perfiles/$(resource.data.uid)).data.username != username
          && applyingApprovedProfileRequest(resource.data.uid);
    }

    // Published picks are readable only when the owning tipster is approved.
    // Writes require the authenticated owner to have current approval.
    match /picks/{pickId} {
      function pickIsEditable(data) {
        return pickEventDate(data) > request.time && pickStatus(data) == "pending";
      }
      function consistentCashOut() {
        let privatePath = /databases/$(database)/documents/picks/$(pickId)/private/bankroll;
        return request.resource.data.status == "cashed_out"
          ? !existsAfter(privatePath)
            || getAfter(privatePath).data.keys().hasAll(["returnAmount", "returnMinorUnits"])
          : !existsAfter(privatePath)
            || !getAfter(privatePath).data.keys().hasAny(["returnAmount", "returnMinorUnits"]);
      }
      // Deleted query results carry no resource; existing picks still require approval.
      allow read: if resource == null
        || (resource.data.user_id is string && profileIsApproved(resource.data.user_id))
        || hasAdminPermission("kpis");
      allow create: if verifiedUser()
        && acceptedCurrentTerms(request.auth.uid)
        && profileIsApproved(request.auth.uid)
        && validPick(request.resource.data, request.auth.uid)
        && request.resource.data.status == "pending"
        && request.resource.data.stake != null
        && request.resource.data.league.size() > 0
        && request.resource.data.market.size() > 0
        && request.resource.data.event_date > request.time
        && request.resource.data.created_at == request.time;
      allow update: if verifiedUser()
        && acceptedCurrentTerms(request.auth.uid)
        && profileIsApproved(request.auth.uid)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && validPick(request.resource.data, request.auth.uid)
        && request.resource.data.created_at == resource.data.created_at
        && pickStatus(resource.data) == "pending"
        && (request.resource.data.stake != null || resource.data.get("stake", null) == null)
        && (request.resource.data.status == "pending"
          ? pickIsEditable(resource.data) && request.resource.data.event_date > request.time
          : samePickTerms(resource.data, request.resource.data))
        && consistentCashOut();
      allow delete: if verifiedUser()
        && acceptedCurrentTerms(request.auth.uid)
        && profileIsApproved(request.auth.uid)
        && resource.data.user_id == request.auth.uid
        && pickIsEditable(resource.data)
        && !existsAfter(/databases/$(database)/documents/picks/$(pickId)/private/bankroll);

      match /private/{privateId} {
        function parentPickIsEditable() {
          let pick = get(/databases/$(database)/documents/picks/$(pickId)).data;
          return pickEventDate(pick) > request.time && pickStatus(pick) == "pending";
        }
        function ownsPick() {
          return request.auth != null
            && get(/databases/$(database)/documents/picks/$(pickId)).data.user_id == request.auth.uid;
        }
        function canSaveBankroll() {
          return verifiedUser()
            && acceptedCurrentTerms(request.auth.uid)
            && profileIsApproved(request.auth.uid)
            && getAfter(/databases/$(database)/documents/picks/$(pickId)).data.user_id == request.auth.uid;
        }
        function validBankroll() {
          let data = request.resource.data;
          return data.keys().hasAll(["stakeAmount", "stakeMinorUnits", "currency", "created_at", "updated_at"])
            && data.keys().hasOnly(["stakeAmount", "stakeMinorUnits", "currency", "created_at", "updated_at", "returnAmount", "returnMinorUnits"])
            && data.currency in ["PEN", "USD", "EUR"]
            && data.stakeMinorUnits is int
            && data.stakeMinorUnits > 0
            && data.stakeMinorUnits <= 100000000000
            && data.stakeAmount is number
            && data.stakeAmount == data.stakeMinorUnits / 100.0
            && (pickStatus(getAfter(/databases/$(database)/documents/picks/$(pickId)).data) == "cashed_out"
              ? data.keys().hasAll(["returnAmount", "returnMinorUnits"])
                && data.returnMinorUnits is int
                && data.returnMinorUnits >= 0
                && data.returnMinorUnits <= 100000000000
                && data.returnAmount is number
                && data.returnAmount == data.returnMinorUnits / 100.0
              : !data.keys().hasAny(["returnAmount", "returnMinorUnits"]))
            && data.updated_at == request.time;
        }
        allow read: if privateId == "bankroll" && ownsPick();
        allow create: if privateId == "bankroll"
          && canSaveBankroll()
          && (!exists(/databases/$(database)/documents/picks/$(pickId)) || parentPickIsEditable())
          && validBankroll()
          && request.resource.data.created_at == request.time;
        allow update: if privateId == "bankroll"
          && ownsPick()
          && canSaveBankroll()
          && validBankroll()
          && (parentPickIsEditable()
            || (pickStatus(get(/databases/$(database)/documents/picks/$(pickId)).data) == "pending"
              && pickStatus(getAfter(/databases/$(database)/documents/picks/$(pickId)).data) != "pending"
              && request.resource.data.stakeAmount == resource.data.stakeAmount
              && request.resource.data.stakeMinorUnits == resource.data.stakeMinorUnits
              && request.resource.data.currency == resource.data.currency))
          && (pickStatus(getAfter(/databases/$(database)/documents/picks/$(pickId)).data)
              == pickStatus(get(/databases/$(database)/documents/picks/$(pickId)).data)
            || (request.resource.data.stakeAmount == resource.data.stakeAmount
              && request.resource.data.stakeMinorUnits == resource.data.stakeMinorUnits
              && request.resource.data.currency == resource.data.currency))
          && request.resource.data.created_at == resource.data.created_at;
        allow delete: if privateId == "bankroll"
          && ownsPick()
          && verifiedUser()
          && acceptedCurrentTerms(request.auth.uid)
          && profileIsApproved(request.auth.uid)
          && (!existsAfter(/databases/$(database)/documents/picks/$(pickId))
            || (parentPickIsEditable()
              && pickStatus(getAfter(/databases/$(database)/documents/picks/$(pickId)).data) != "cashed_out"));
      }
    }
  }
}
